<?xml version="1.0"?>
<robot name="plate">
  <link name="base_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.12" length="0.02"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.02"/>
      </geometry>
    </visual>
  </link>
</robot>
